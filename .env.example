# Glaze Pro VM deployment settings
PORT=3000
APP_URL="https://your-afraid-subdomain.example.com"

# Used to hash OTP codes before storage. Change this before production.
SESSION_SECRET="replace-with-a-long-random-secret"

# Email OTP behavior
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Current beta behavior:
# OTP codes are generated by the backend, hashed in db.json, and printed in server logs.
# Add a transactional mail provider later when you are ready to deliver real emails.
