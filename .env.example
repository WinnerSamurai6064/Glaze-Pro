# Glaze Pro VM deployment settings
PORT=3000
APP_URL="https://glaze.kje.us"

# Used to hash OTP codes and OAuth temporary values. Change this before production.
SESSION_SECRET="replace-with-a-long-random-secret"

# Google OAuth
# In Google Cloud Console, add this redirect URI:
# https://glaze.kje.us/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Optional. Leave empty unless you need to override APP_URL based callback generation.
GOOGLE_REDIRECT_URI=""

# Email OTP behavior
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Current beta behavior:
# OTP codes are generated by the backend, hashed in db.json, and printed in server logs.
# Add a transactional mail provider later when you are ready to deliver real emails.
